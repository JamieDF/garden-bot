GROW_POLL_INTERVAL=30
GROW_DATABASE_PATH=/var/lib/garden-bot/readings.db
GROW_BME280_ADDRESS=118
GROW_BMP280_ADDRESS=119
GROW_HOST=0.0.0.0
GROW_PORT=8000

# Agent / LLM (any OpenAI-compatible endpoint: llama-server, Ollama, hosted)
GROW_LLM_ENABLED=false
GROW_LLM_BASE_URL=http://localhost:8080/v1
GROW_LLM_MODEL=smollm2-135m
GROW_LLM_API_KEY=none
GROW_AGENT_WAKE_INTERVAL=1800
GROW_AGENT_EVENT_WAKE_MIN=300

# Weather (Open-Meteo, free, no key). Agent observes weather when both are set.
# GROW_WEATHER_LAT=51.5
# GROW_WEATHER_LON=-0.12
